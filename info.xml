<?xml version="1.0"?>
<extension key="uk.co.cloudtopconsulting.charitylookup" type="module">
  <file>charitylookup</file>
  <name>Charity Lookup</name>
  <description>Look up UK registered charities on the Charity Commission (England &amp; Wales) register and update organisation details.</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Cloud Top Consulting Ltd</name>
      <email>roger@cloudtopconsulting.co.uk</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://FIXME</url>
    <url desc="Documentation">https://FIXME</url>
    <url desc="Support">https://FIXME</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-11-18</releaseDate>
  <version>0.1.0</version>
  <develStage>alpha</develStage>
  <compatibility mode="semver">
    <comments>Semantic versioning. For example, compatibility with "6.1" implies compatibility with "6.2".</comments>
    <ver>6.20</ver>
  </compatibility>
  <php_compatibility mode="list">
    <comments>Listed versions. For example, specify both "8.1" and "8.2".</comments>
    <ver>8.0</ver>
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <smarty_compatibility mode="list">
    <comments>Listed versions. For example, specify both "4" and "5".</comments>
    <ver>5</ver>
  </smarty_compatibility>
  <comments>Requires a Charity Commission API subscription key: https://api-portal.charitycommission.gov.uk/</comments>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Charitylookup</namespace>
    <format>26.10.3</format>
    <angularModule>crmCharitylookup</angularModule>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
</extension>
